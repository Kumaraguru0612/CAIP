# CAIP Environment Configuration Template
# Copy this file to .env and fill in real values before running Docker Compose
# or connecting to external PostgreSQL / Neo4j instances.
# Never commit .env to version control.

# Application Settings
ENVIRONMENT=development
CAIP_PORT=8000

# PostgreSQL Configuration
# Locally, if DATABASE_URL and POSTGRES_PASSWORD are left unset/empty,
# CAIP automatically falls back to local SQLite (backend/caip_local.db).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caip
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/caip

# Neo4j Context Graph Configuration (optional for local SQLite mode)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
